# KAMP - line purge only.
#
# Adaptive_Meshing.cfg is deliberately NOT included: FreeDi PRINT_START already
# calls native Klipper `BED_MESH_CALIBRATE ADAPTIVE=1`, which does the same job.
[include ./KAMP/Line_Purge.cfg]
#[include ./KAMP/Adaptive_Meshing.cfg]
#[include ./KAMP/Voron_Purge.cfg]
#[include ./KAMP/Smart_Park.cfg]

[gcode_macro _KAMP_Settings]
description: This macro contains all adjustable settings for KAMP
variable_verbose_enable: True               # KAMP prints what it is doing to the console

# Adaptive meshing (unused here - meshing is native in FreeDi PRINT_START)
variable_mesh_margin: 0
variable_fuzz_amount: 0

# Dockable probe - not applicable to the Plus4 piezo probe
variable_probe_dock_enable: False
variable_attach_macro: "Attach_Probe"
variable_detach_macro: "Dock_Probe"

# Line purge - values carried over from the working stock QIDI config
variable_purge_height: 0.8                  # Z height of nozzle during purge
variable_tip_distance: 0                    # filament tip to nozzle before purge
variable_purge_margin: 20                   # distance in front of the print area
variable_purge_amount: 30                   # mm of filament purged
variable_flow_rate: 4                       # mm3/s

variable_smart_park_height: 10

gcode: # Gcode section left intentionally blank. Do not disturb.
    {action_respond_info(" Running the KAMP_Settings macro does nothing, it is only used for storing KAMP settings. ")}
